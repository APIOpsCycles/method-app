{
  "compilerOptions": {
    "target": "ES2020", "lib": ["DOM", "ES2020"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "declaration": true, "declarationMap": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/react/**/*.tsx", "src/assets/**/*.ts", "src/metadata/**/*.json"]
}
