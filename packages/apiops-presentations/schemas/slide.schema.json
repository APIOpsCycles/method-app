{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APIOps partner slide",
  "type": "object",
  "required": ["id", "title", "elements", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string"},
    "notes": {"type": "string"},
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["text", "code", "bullets", "numbered", "table", "image"]},
          "text": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
          "header": {"type": "boolean"},
          "emphasizeFirstColumn": {"type": "boolean"},
          "emphasis": {"type": "array", "items": {"type": "string"}},
          "asset": {"type": "string"},
          "alt": {"type": "string"},
          "fit": {"enum": ["contain", "cover"]}
        },
        "allOf": [
          {"if": {"properties": {"type": {"enum": ["text", "code"]}}}, "then": {"required": ["text"]}},
          {"if": {"properties": {"type": {"enum": ["bullets", "numbered"]}}}, "then": {"required": ["items"]}},
          {"if": {"properties": {"type": {"const": "table"}}}, "then": {"required": ["rows", "header", "emphasizeFirstColumn"]}},
          {"if": {"properties": {"type": {"const": "image"}}}, "then": {"required": ["asset", "alt", "fit"]}}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
