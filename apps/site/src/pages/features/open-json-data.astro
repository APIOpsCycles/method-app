---
import BaseLayout from "../../layouts/BaseLayout.astro"; import FeaturePage from "../../components/content/FeaturePage.astro"; import { metadataForRoute } from "../../lib/seo";
const canonicalPath="/features/open-json-data"; const seo=metadataForRoute("feature","en",canonicalPath);
---
<BaseLayout title="Open JSON Data" description="Download localized, versionable APIOps Cycles JSON for integrations and offline tools." lang="en" canonicalPath={canonicalPath} {...seo}><FeaturePage kicker="Open by design" title="The method is data, not just pages" lead="Use the same generated JSON that powers the site. Catalog content, graph relationships, canvases, routes, prompts, and integration manifests are downloadable without scraping presentation markup." sectionKicker="Integration surfaces" sectionTitle="Portable artifacts with stable identities" sectionIntro="Static files are easy to cache, diff, mirror, validate, or consume offline. Localized content is separated from shared structural data so applications can choose exactly what they need." details={[{title:"Localized catalogs",text:"Method catalogs, interface labels, canvas manifests, export templates, and prompt packs are published per supported locale."},{title:"Shared indexes",text:"Route, graph, partner, announcement, and integration metadata are emitted once where language does not change their identity."},{title:"Predictable delivery",text:"Plain JSON works in build pipelines, browser applications, scripts, search indexes, and agent tooling without a proprietary SDK."},{title:"Source-aligned",text:"Generated artifacts preserve stable entity IDs and can be regenerated from canonical method data, making changes reviewable."}]} calloutTitle="Use the data directly" calloutText="Download individual artifacts or inspect them in the browser, then compose the pieces appropriate to your integration." ctaHref="/data" ctaLabel="Browse all JSON files" /></BaseLayout>
