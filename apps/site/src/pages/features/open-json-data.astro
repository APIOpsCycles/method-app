---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturePage from "../../components/content/FeaturePage.astro";
import { metadataForRoute } from "../../lib/seo";

const canonicalPath = "/features/open-json-data";
const seo = metadataForRoute("feature", "en", canonicalPath);
---
<BaseLayout title="Open JSON Data" description="Download localized, versionable APIOps Cycles JSON for integrations and offline tools." lang="en" canonicalPath={canonicalPath} {...seo}>
  <FeaturePage kicker="Open by design" title="The method is data, not just pages" lead="Use generated JSON for catalog content, graph relationships, canvases, prompts, and AI integrations without scraping presentation markup." sectionKicker="Integration surfaces" sectionTitle="Portable artifacts with stable identities" sectionIntro="Static files are easy to cache, diff, mirror, validate, or consume offline. Localized method content is separated from language-independent structure so applications can choose exactly what they need." details={[
    { title: "Localized method content", text: "Method catalogs, canvas manifests, export templates, and prompt packs are published for each supported locale." },
    { title: "Knowledge graph", text: "The versioned method graph provides direct indexes for relationships among cycles, lines, stations, stakeholders, goals, and resources." },
    { title: "Predictable delivery", text: "Plain JSON works in build pipelines, browser applications, scripts, search indexes, and agent tooling without a proprietary SDK." },
    { title: "Open canonical source", text: "Generated artifacts preserve stable entity IDs and originate in the public method-data project, where history and proposed changes remain reviewable." },
  ]} calloutTitle="Browse the published data" calloutText="Download the complete set of generated JSON artifacts available from this site, including files that are produced during the site build." ctaHref="/data" ctaLabel="Browse all JSON files">
    <section class="public-section feature-source-note" aria-labelledby="source-data-heading">
      <p class="public-kicker">Canonical source</p>
      <h2 id="source-data-heading">Built from an open method-data repository</h2>
      <p>The underlying method content and its history live in the <a href="https://github.com/APIOpsCycles/apiops-cycles-method-data" target="_blank" rel="noreferrer">apiops-cycles-method-data repository</a>. Some downloadable files are generated by this site and therefore appear only on the Data page.</p>
    </section>
  </FeaturePage>
</BaseLayout>
