---
import BaseLayout from "../../layouts/BaseLayout.astro"; import FeaturePage from "../../components/content/FeaturePage.astro"; import { metadataForRoute } from "../../lib/seo";
const canonicalPath="/features/ai-ready-method"; const seo=metadataForRoute("feature","en",canonicalPath);
---
<BaseLayout title="AI-ready Method" description="Ground AI assistants with structured APIOps Cycles context, prompt packs, and explicit relationships." lang="en" canonicalPath={canonicalPath} {...seo}><FeaturePage kicker="Structured grounding" title="Method context that AI can use" lead="Give assistants small, identifiable, connected units of method knowledge—not a pile of pages to guess from. Generated manifests, prompt packs, and graph relationships create an inspectable grounding layer." sectionKicker="For agents and assistants" sectionTitle="Bound the context before generating the answer" sectionIntro="Stable IDs connect human-readable content to machine-readable relationships. Clients can select the relevant role, goal, station, and resources before asking a model to assist." details={[{title:"Prompt packs",text:"Localized prompt packs package reusable method instructions so integrations can begin from maintained guidance rather than improvised system prompts."},{title:"Method manifest",text:"The MCP-oriented manifest advertises method data surfaces to tools and agents, making available context discoverable."},{title:"Graph-grounded retrieval",text:"Resolve adjacent stations, participating roles, and supporting resources through explicit edges instead of similarity alone."},{title:"Human-verifiable output",text:"Every unit retains a stable route and identity, so generated recommendations can point people back to the source method page."}]} calloutTitle="Build on the published artifacts" calloutText="Review the downloadable prompt packs, manifest, graph, and catalog before connecting the method to your assistant." ctaHref="/data" ctaLabel="Browse method data" /></BaseLayout>
