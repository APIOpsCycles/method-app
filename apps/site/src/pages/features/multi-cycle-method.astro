---
import BaseLayout from "../../layouts/BaseLayout.astro"; import FeaturePage from "../../components/content/FeaturePage.astro"; import { metadataForRoute } from "../../lib/seo";
const canonicalPath="/features/multi-cycle-method"; const seo=metadataForRoute("feature","en",canonicalPath);
---
<BaseLayout title="Multi-cycle Method" description="Use connected APIOps Cycles journeys without reducing product work to one linear process." lang="en" canonicalPath={canonicalPath} {...seo}><FeaturePage kicker="Connected journeys" title="One method. Multiple cycles." lead="API and integration products do not move through a single funnel. Choose the cycle that matches the outcome in front of you, then cross into another journey when the work changes." sectionKicker="Method structure" sectionTitle="Journeys overlap where the work overlaps" sectionIntro="Cycles supply goal-oriented sequences, while metro lines connect related practices across those sequences. Shared stations make handoffs explicit rather than duplicating guidance." details={[{title:"Start with the outcome",text:"Select a cycle for the current initiative instead of treating every station as a mandatory maturity ladder."},{title:"Keep canonical order",text:"Each cycle provides a deliberate station sequence, giving teams a coherent path while leaving room to enter where their work actually begins."},{title:"Cross cycle boundaries",text:"Metro lines reveal the same practice in different journeys, making it easy to continue a concern such as design, governance, or operations."},{title:"Reuse shared stations",text:"A station can participate in multiple cycles. Its decisions and resources stay consistent while the surrounding journey context changes."}]} calloutTitle="Choose your current journey" calloutText="Explore the map, select a cycle, and follow its stations—or use a metro line to see the practice across cycles." ctaHref="/#method-context-controls" ctaLabel="Explore the method map" /></BaseLayout>
