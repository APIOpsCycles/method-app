---
import BaseLayout from "../../layouts/BaseLayout.astro"; import FeaturePage from "../../components/content/FeaturePage.astro"; import { metadataForRoute } from "../../lib/seo";
const canonicalPath="/features/canvas-workspace"; const seo=metadataForRoute("feature","en",canonicalPath);
---
<BaseLayout title="Canvas Workspace" description="Run APIOps Cycles canvases locally, focus workshops, and export portable results." lang="en" canonicalPath={canonicalPath} {...seo}><FeaturePage kicker="From guidance to work" title="A workshop canvas in your browser" lead="Open a method canvas beside the guidance that calls for it. Capture notes, focus the room, present the result, and take the work with you—without sending workshop content to a server." sectionKicker="Local workspace" sectionTitle="Facilitation tools without platform lock-in" sectionIntro="Canvas definitions supply structured zones and instructions. The workspace layers on local persistence and portable import and export so a session can continue beyond one browser tab." details={[{title:"Private by default",text:"Notes and canvas metadata persist in browser local storage under keys scoped to the method entity and canvas."},{title:"Focus and present",text:"Select an active section, hide the rest when the conversation needs focus, then enter presentation mode for a clean full-screen view."},{title:"Portable JSON",text:"Export template-aware JSON with metadata and sticky notes. Imports validate the template and every known section before restoring content."},{title:"Readable Markdown",text:"Export the canvas purpose, instructions, ownership metadata, section descriptions, and notes as a document ready for repositories or team tools."}]} calloutTitle="Try the Customer Journey Canvas" calloutText="Open a real canvas workspace, add workshop notes, focus on one section, and export the result when you are done." ctaHref="/resources/customer-journey-canvas" ctaLabel="Open Customer Journey Canvas" /></BaseLayout>
