---
import PartnersContent from "../components/content/PartnersContent.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { metadataForRoute } from "../lib/seo";
const locale = "en";
const canonicalPath = "/partners";
const seo = metadataForRoute("partners", locale, canonicalPath);
---
<BaseLayout title="Partners and whitepapers" description="Explore APIOps Cycles whitepapers, download practical resources and find a partner to discuss your API or AI integration challenge." lang={locale} canonicalPath={canonicalPath} {...seo}><PartnersContent /></BaseLayout>
