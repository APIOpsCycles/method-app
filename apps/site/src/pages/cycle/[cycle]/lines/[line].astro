---
import LineContent from "../../../../components/content/LineContent.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { itemListJsonLd, metadataForRoute } from "../../../../lib/seo";
import { getCatalog, getCycle, getLine, type Locale } from "../../../../lib/method-data";
export function getStaticPaths() { const data = getCatalog("en"); return data.cycles.flatMap((cycle) => data.lines.filter((line) => line.stations.some((id) => cycle.stations.some((station) => station.id === id))).map((line) => ({ params: { cycle: cycle.slug, line: line.slug }, props: { locale: "en" as Locale } }))); }
const { locale } = Astro.props;
const cycle = getCycle(locale, Astro.params.cycle!); const line = getLine(locale, Astro.params.line!);
if (!cycle || !line) throw new Error("Unknown cycle or line");
const canonicalPath = `/cycle/${cycle.slug}/lines/${line.slug}`;
const prefix = locale === "en" ? "" : `/${locale}`;
const seo = metadataForRoute("line", locale, canonicalPath);
const jsonLd = itemListJsonLd(line, cycle, locale, canonicalPath, (station) => `${prefix}/stations/${station.id}`);
---
<BaseLayout title={line.title} description={line.description} lang={locale} canonicalPath={canonicalPath} {...seo} openGraphType="article" jsonLd={jsonLd}><LineContent cycle={cycle} line={line} locale={locale} /></BaseLayout>
