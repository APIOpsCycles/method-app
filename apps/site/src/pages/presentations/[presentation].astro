---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {presentationEditions,presentationCatalog,presentationRelease,presentationPath,previewFor,downloadsFor,artifactUrl,fileSize} from '../../content/presentations';
import {getCatalog} from '../../lib/method-data';
import {canonicalUrl} from '../../env';
import '../../styles/presentations.css';
export function getStaticPaths(){return presentationEditions.map(edition=>({params:{presentation:edition.id},props:{edition}}));}
const {edition}=Astro.props;
const files=downloadsFor(edition.id),stations=getCatalog('en').stations.filter(s=>edition.stations.includes(s.id));
const jsonLd={'@context':'https://schema.org','@type':'LearningResource',name:edition.title,description:edition.description,inLanguage:'en',url:canonicalUrl(presentationPath(edition.id)),version:presentationCatalog.version,dateModified:presentationCatalog.released,learningResourceType:'Presentation'};
---
<BaseLayout title={edition.title} description={edition.description} canonicalPath={presentationPath(edition.id)} lang="en" jsonLd={jsonLd} socialImage={previewFor(edition.id)}>
  <main class="public-content presentation-detail">
    <nav class="public-breadcrumbs" aria-label="Breadcrumb"><a href="/">APIOps Cycles</a><span aria-hidden="true">/</span><a href="/presentations">Presentations</a><span aria-hidden="true">/</span><span>{edition.title}</span></nav>
    <section class="public-hero"><p class="public-kicker">Presentation · English</p><h1>{edition.title}</h1><p>{edition.description}</p><p class="presentation-meta">{edition.slideCount} slides · About {edition.durationMinutes} minutes · Updated {presentationCatalog.released} · Version {presentationCatalog.version}</p>
      <div class="presentation-actions"><a class="presentation-button" href={`${presentationPath(edition.id)}/view`}>View slides online</a><a class="presentation-button presentation-button--secondary" href={artifactUrl(files.pptx)} download>Download PowerPoint ({fileSize(files.pptx.bytes)})</a><a class="presentation-button presentation-button--secondary" href={artifactUrl(files.pdf)} download>Download PDF ({fileSize(files.pdf.bytes)})</a><a class="presentation-button presentation-button--secondary" href={artifactUrl(files.reveal)} download>Download Reveal.js ({fileSize(files.reveal.bytes)})</a></div>
    </section>
    <a class="presentation-cover" href={`${presentationPath(edition.id)}/view`} aria-label={`View ${edition.title} online`}><img src={previewFor(edition.id)} width="1280" height="720" alt={`Cover of ${edition.title}`} fetchpriority="high" /></a>
    <section class="public-section presentation-adapt-grid"><div><h2>Who this is for</h2><ul>{edition.audience.map(a=><li>{a}</li>)}</ul></div><div><h2>What it covers</h2><ul>{edition.topics.map(t=><li>{t}</li>)}</ul></div></section>
    <section class="public-section" aria-labelledby="adapt"><h2 id="adapt">Adapt this presentation</h2><p><strong>Using PowerPoint:</strong> edit the downloaded deck, replace the logo and choose the slides that fit your talk. Text, native lists and tables are editable; canvas diagrams and illustrations remain images.</p><p><strong>Using code:</strong> change shared slide JSON or a brand file and rebuild the formats you need. The kit includes editable canvas JSON and a partner branding example.</p><div class="presentation-actions"><a class="presentation-button presentation-button--secondary" href={artifactUrl(presentationRelease.source)} download>Download source kit (ZIP, {fileSize(presentationRelease.source.bytes)})</a><a class="presentation-text-link" href="/presentations/developers">Read the developer guide →</a><a class="presentation-text-link" href={artifactUrl(files.notes)} download>Download speaker notes</a></div></section>
    <section class="public-section" aria-labelledby="visuals"><h2 id="visuals">Find or create visuals</h2><p><a href="/design-system/visuals">Use existing APIOps assets or create a new scene</a> with the Character Grammar, editable SVG recipes or an AI illustration brief. The guide includes instructions for PowerPoint and the shared presentation source.</p></section>
    <section class="public-section" aria-labelledby="stations"><h2 id="stations">Explore the method</h2><p><a href="/cycles/api-productization-cycle">API Productization Cycle</a></p><ul class="presentation-stations">{stations.map(s=><li><a href={`/stations/${s.id}`}>{s.title}</a></li>)}</ul></section>
    <section class="public-section presentation-reuse" aria-labelledby="reuse"><h2 id="reuse">Reuse and source versions</h2><p>Retain APIOps Cycles and canvas attribution when adapting method material. Case-study engagement: APIsFirst with partner Osaango. Illustrative examples are distinguished from client results.</p><p><a href="/licensing">Read the licensing guidance</a> · <a href={artifactUrl({...presentationRelease.source,file:'manifest.json'})}>Release manifest and checksums</a></p><p class="presentation-meta">Method-data {presentationCatalog.methodDataVersion} · create-apiops {presentationCatalog.scaffoldVersion} · Estimated presentation time varies with discussion.</p></section>
  </main>
</BaseLayout>
