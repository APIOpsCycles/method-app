---
import LicensingContent from "../../components/content/LicensingContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { metadataForRoute } from "../../lib/seo";
import { localizedLocales, type Locale } from "../../lib/method-data";
export function getStaticPaths() { return localizedLocales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const canonicalPath = `/${locale}/licensing`;
const seo = metadataForRoute("licensing", locale, canonicalPath);
---
<BaseLayout title="Licensing" lang={locale} canonicalPath={canonicalPath} {...seo}><LicensingContent /></BaseLayout>
