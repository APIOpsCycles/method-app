---
import HomeContent from "../../components/content/HomeContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLabels, localizedLocales, type Locale } from "../../lib/method-data";
import { metadataForRoute, websiteJsonLd } from "../../lib/seo";
export function getStaticPaths() { return localizedLocales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const canonicalPath = `/${locale}/`;
const labels = getLabels(locale);
const title = labels["home.title"];
const description = labels["home.description"];
const seo = metadataForRoute("home", locale, canonicalPath);
---
<BaseLayout title={title} description={description} lang={locale} canonicalPath={canonicalPath} {...seo} jsonLd={websiteJsonLd(locale, title, description, canonicalPath)}><HomeContent locale={locale} /></BaseLayout>
