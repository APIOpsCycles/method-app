---
import LineContent from "../../../../../components/content/LineContent.astro";
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import { itemListJsonLd, metadataForRoute } from "../../../../../lib/seo";
import { getCatalog, getCycle, getLine, localizedLocales, type Locale } from "../../../../../lib/method-data";
export function getStaticPaths() { return localizedLocales.flatMap((locale) => { const data = getCatalog(locale); return data.cycles.flatMap((cycle) => data.lines.filter((line) => line.stations.some((id) => cycle.stations.some((station) => station.id === id))).map((line) => ({ params: { locale, cycle: cycle.slug, line: line.slug }, props: { locale } }))); }); }
const { locale } = Astro.props as { locale: Locale };
const cycle = getCycle(locale, Astro.params.cycle!); const line = getLine(locale, Astro.params.line!);
if (!cycle || !line) throw new Error("Unknown cycle or line");
const canonicalPath = `/${locale}/cycle/${cycle.slug}/lines/${line.slug}`;
const prefix = locale === "en" ? "" : `/${locale}`;
const seo = metadataForRoute("cycleLine", locale, canonicalPath);
const jsonLd = itemListJsonLd(line, cycle, locale, canonicalPath, (station) => `${prefix}/cycles/${cycle.slug}/stations/${station.id}`);
---
<BaseLayout title={line.title} description={line.description} lang={locale} canonicalPath={canonicalPath} {...seo} openGraphType="article" jsonLd={jsonLd}><LineContent cycle={cycle} line={line} locale={locale} /></BaseLayout>
