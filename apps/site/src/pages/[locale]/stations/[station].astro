---
import StationContent from "../../../components/content/StationContent.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCatalog, getStation, localizedLocales, type Locale } from "../../../lib/method-data";
export function getStaticPaths() { return localizedLocales.flatMap((locale) => getCatalog(locale).stations.map((item) => ({ params: { locale, station: item.id }, props: { locale } }))); }
const { locale } = Astro.props as { locale: Locale };
const item = getStation(locale, Astro.params.station!);
if (!item) throw new Error("Unknown station");
const canonicalPath = `/${locale}/stations/${item.id}`;
---
<BaseLayout title={item.title} description={item.description} lang={locale} canonicalPath={canonicalPath}><StationContent station={item} locale={locale} /></BaseLayout>
