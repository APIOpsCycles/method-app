---
import PartnersContent from "../../components/content/PartnersContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { localizedLocales, type Locale } from "../../lib/method-data";
export function getStaticPaths() { return localizedLocales.map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
---
<BaseLayout title="Partners" lang={locale} canonicalPath={`/${locale}/partners`}><PartnersContent /></BaseLayout>
