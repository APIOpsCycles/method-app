---
import CycleContent from "../../../components/content/CycleContent.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { learningResourceJsonLd, metadataForRoute } from "../../../lib/seo";
import { getCatalog, getCycle, localizedLocales, type Locale } from "../../../lib/method-data";
export function getStaticPaths() { return localizedLocales.flatMap((locale) => getCatalog(locale).cycles.map((item) => ({ params: { locale, cycle: item.slug }, props: { locale } }))); }
const { locale } = Astro.props as { locale: Locale };
const item = getCycle(locale, Astro.params.cycle!);
if (!item) throw new Error("Unknown cycle");
const canonicalPath = `/${locale}/cycles/${item.slug}`;
const homePath = locale === "en" ? "/" : `/${locale}/`;
const seo = metadataForRoute("cycle", locale, canonicalPath);
const jsonLd = learningResourceJsonLd(item, locale, canonicalPath, [{ name: "APIOps Cycles", path: homePath }, { name: item.title, path: canonicalPath }]);
---
<BaseLayout title={item.title} description={item.description} lang={locale} canonicalPath={canonicalPath} {...seo} openGraphType="article" jsonLd={jsonLd}><CycleContent cycle={item} locale={locale} /></BaseLayout>
