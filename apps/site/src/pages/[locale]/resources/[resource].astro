---
import ResourceContent from "../../../components/content/ResourceContent.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { learningResourceJsonLd, metadataForRoute } from "../../../lib/seo";
import { getCatalog, getResource, localizedLocales, resourcePath, resourceRouteSegment, type Locale } from "../../../lib/method-data";
export function getStaticPaths() { return localizedLocales.flatMap((locale) => getCatalog(locale).resources.filter((item) => !item.draft).map((item) => ({ params: { locale, resource: resourceRouteSegment(item) }, props: { locale } }))); }
const { locale } = Astro.props as { locale: Locale };
const item = getResource(locale, Astro.params.resource!);
if (!item) throw new Error("Unknown resource");
const canonicalPath = resourcePath(locale, item);
const homePath = locale === "en" ? "/" : `/${locale}/`;
const seo = metadataForRoute("resource", locale, canonicalPath);
const jsonLd = learningResourceJsonLd(item, locale, canonicalPath, [{ name: "APIOps Cycles", path: homePath }, { name: item.title, path: canonicalPath }]);
---
<BaseLayout title={item.title} description={item.description} lang={locale} canonicalPath={canonicalPath} {...seo} openGraphType="article" jsonLd={jsonLd}><ResourceContent resource={item} locale={locale} /></BaseLayout>
