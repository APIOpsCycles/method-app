---
import ResourceContent from "../../../components/content/ResourceContent.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCatalog, getResource, localizedLocales, type Locale } from "../../../lib/method-data";
export function getStaticPaths() { return localizedLocales.flatMap((locale) => getCatalog(locale).resources.filter((item) => !item.draft).map((item) => ({ params: { locale, resource: item.id }, props: { locale } }))); }
const { locale } = Astro.props as { locale: Locale };
const item = getResource(locale, Astro.params.resource!);
if (!item) throw new Error("Unknown resource");
const canonicalPath = `/${locale}/resources/${item.id}`;
---
<BaseLayout title={item.title} description={item.description} lang={locale} canonicalPath={canonicalPath}><ResourceContent resource={item} locale={locale} /></BaseLayout>
