---
import ResourcesContent from '../../../components/content/ResourcesContent.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {metadataForRoute} from '../../../lib/seo';
import {localizedLocales,localePrefix,type Locale} from '../../../lib/method-data';
import {resourceLibraryCopy} from '../../../lib/resource-library';
export function getStaticPaths(){return localizedLocales.map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props as {locale:Locale};
const canonicalPath=`${localePrefix(locale)}/resources`,copy=resourceLibraryCopy[locale];
---
<BaseLayout title={copy.title} description={copy.intro} lang={locale} canonicalPath={canonicalPath} {...metadataForRoute('resources',locale,canonicalPath)}><ResourcesContent locale={locale}/></BaseLayout>
