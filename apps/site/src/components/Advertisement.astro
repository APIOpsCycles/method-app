---
import type { Ad } from "../../../../data/ads";

interface Props {
  ad: Ad;
}

const { ad } = Astro.props;
---
<aside class="advertisement-rail" aria-label="Community notice" style={`--advertisement-color: ${ad.bgcolor ?? "var(--color-accent-600)"}`}>
  <article class:list={["advertisement-card", { "advertisement-card--full-visual": ad.visual?.fit === 'contain' }]}>
    {ad.visual && (ad.visual.fit === 'contain'
      ? <a class="advertisement-card__visual-link" href={ad.ctaHref}><img class="advertisement-card__visual advertisement-card__visual--contain" src={ad.visual.src} alt={ad.visual.alt} loading="lazy" /></a>
      : <img class="advertisement-card__visual" src={ad.visual.src} alt={ad.visual.alt} loading="lazy" />)}
    <div class="advertisement-card__copy">
      <p class="advertisement-card__label">From the APIOps community</p>
      <h2>{ad.headline}</h2>
      <p>{ad.text}</p>
      <a class="advertisement-card__cta" href={ad.ctaHref}>{ad.ctaText}<span aria-hidden="true"> →</span></a>
    </div>
  </article>
</aside>

<style>
  .advertisement-card__visual-link { display: block; align-self: center; }
  .advertisement-card__visual--contain { height: auto; min-height: 0; object-fit: contain; }
  .advertisement-card--full-visual .advertisement-card__label { color: var(--foreground, #0f172a); }
  .advertisement-card__visual-link:focus-visible { outline: 3px solid var(--foreground, #0f172a); outline-offset: -3px; }
</style>

<script is:inline>
  (() => {
    const script = document.currentScript;
    const rail = script?.previousElementSibling;
    const shell = rail?.parentElement;
    const content = shell?.querySelector(":scope > .public-content");
    const mobileQuery = window.matchMedia("(max-width: 83.999rem)");
    if (!rail || !shell || !content) return;

    const placeAdvertisement = () => {
      if (mobileQuery.matches) {
        const firstSection = content.querySelector(":scope > .public-section");
        content.insertBefore(rail, firstSection ?? null);
      } else {
        shell.insertBefore(rail, script);
      }
    };

    placeAdvertisement();
    mobileQuery.addEventListener("change", placeAdvertisement);
  })();
</script>
