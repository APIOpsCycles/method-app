---
import ConfluenceExportIsland from "../islands/ConfluenceExportIsland";
import PromptPackIsland from "../islands/PromptPackIsland";
import ResourceViewerIsland from "../islands/ResourceViewerIsland";
import { getLabels, pickLabels, getStationResources, type Cycle, type Locale, type Role, type Station } from "../../lib/method-data";
import promptsEn from "../../../../../generated/method/prompt-packs.en.json";
import promptsFi from "../../../../../generated/method/prompt-packs.fi.json";
import promptsFr from "../../../../../generated/method/prompt-packs.fr.json";
import promptsDe from "../../../../../generated/method/prompt-packs.de.json";
import promptsPt from "../../../../../generated/method/prompt-packs.pt.json";
import exportsEn from "../../../../../generated/method/export-templates.en.json";
import exportsFi from "../../../../../generated/method/export-templates.fi.json";
import exportsFr from "../../../../../generated/method/export-templates.fr.json";
import exportsDe from "../../../../../generated/method/export-templates.de.json";
import exportsPt from "../../../../../generated/method/export-templates.pt.json";

interface Props { locale: Locale; cycle?: Cycle; station?: Station; role?: Role; entityId?: string }
const { locale, cycle, station, role, entityId } = Astro.props;
const promptData = { en: promptsEn, fi: promptsFi, fr: promptsFr, de: promptsDe, pt: promptsPt };
const exportData = { en: exportsEn, fi: exportsFi, fr: exportsFr, de: exportsDe, pt: exportsPt };
const labels = getLabels(locale);
const stationResources = station ? getStationResources(locale, station) : [];
const prompts = role ? promptData[locale].translations[locale].filter((prompt) => prompt.routeId === role.id || role.promptIds.includes(prompt.id)) : [];
type ExportRoute = "cycle" | "station" | "role";
type ExportTemplate = (typeof exportData.en.translations.en)[number] & {
  route?: ExportRoute | string;
  routeId?: string;
  entityId?: string;
  entityIds?: string[];
  stationId?: string;
  roleId?: string;
};
const route: ExportRoute | undefined = cycle ? "cycle" : station ? "station" : role ? "role" : undefined;
const currentEntityId = entityId ?? cycle?.id ?? station?.id ?? role?.id;
const routeEntityId = cycle?.id ?? station?.id ?? role?.id;
const templates = (exportData[locale].translations[locale] as ExportTemplate[]).filter((template) => {
  if (!route || !routeEntityId) return false;
  const declaredRoute = template.route?.replace(/^\//, "").split("/")[0].replace(/s$/, "");
  if (declaredRoute && declaredRoute !== route) return false;
  const declaredIds = [template.entityId, ...(template.entityIds ?? [])];
  if (route === "cycle") declaredIds.push(template.cycleId);
  if (route === "station") declaredIds.push(template.stationId);
  if (route === "role") declaredIds.push(template.roleId, template.routeId);
  return declaredIds.filter(Boolean).includes(routeEntityId);
});
---
{(station || role || cycle) && <section class="public-section island-stack" aria-label={labels["tools.aria"]}>
  {station && <><div class="tool-summary"><h2>{labels["tools.reviewResources"]}</h2><p>Browse the resources selected for {station.title}; the summary above explains how they support this station’s work.</p></div><ResourceViewerIsland labels={pickLabels(labels, ["resources.stationKicker", "resources.choose", "section.outcomes", "section.howToUse", "resources.collapse", "resources.expand", "resources.viewSource", "resources.emptyLinked"] as const)} locale={locale} stationId={station.id} stationTitle={station.title} resources={stationResources} client:visible /></>}
  {role && prompts.length > 0 && <><div class="tool-summary"><h2>{labels["tools.facilitate"]} {role.title}</h2><p>Use these prepared prompts alongside the stakeholder decisions, outputs, stations, and resources summarized above.</p></div><PromptPackIsland labels={pickLabels(labels, ["clipboard.copied", "clipboard.failed", "prompt.kicker", "prompt.title", "prompt.choose", "prompt.copy", "prompt.empty"] as const)} locale={locale} routeId={role.id} prompts={prompts} client:visible /></>}
  {currentEntityId && templates.length > 0 && <><div class="tool-summary"><h2>{labels["tools.publish"]} {route}</h2><p>Export the page-specific template after reviewing the entity summary and supporting details above.</p></div><ConfluenceExportIsland labels={pickLabels(labels, ["clipboard.copied", "clipboard.failed", "exports.publishing", "exports.title", "exports.purpose", "exports.empty", "confluence.markdown", "confluence.confluenceWiki", "confluence.copyMarkdown", "confluence.copyConfluenceWiki"] as const)} locale={locale} entityId={currentEntityId} templates={templates} client:visible /></>}
</section>}
