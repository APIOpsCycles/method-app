---
import CanvasWorkspaceIsland from "../islands/CanvasWorkspaceIsland";
import ConfluenceExportIsland from "../islands/ConfluenceExportIsland";
import PromptPackIsland from "../islands/PromptPackIsland";
import ResourceViewerIsland from "../islands/ResourceViewerIsland";
import type { Cycle, Locale, Role, Station } from "../../lib/method-data";
import canvasEn from "../../../../../generated/method/canvas-manifest.en.json";
import canvasFi from "../../../../../generated/method/canvas-manifest.fi.json";
import canvasFr from "../../../../../generated/method/canvas-manifest.fr.json";
import canvasDe from "../../../../../generated/method/canvas-manifest.de.json";
import canvasPt from "../../../../../generated/method/canvas-manifest.pt.json";
import promptsEn from "../../../../../generated/method/prompt-packs.en.json";
import promptsFi from "../../../../../generated/method/prompt-packs.fi.json";
import promptsFr from "../../../../../generated/method/prompt-packs.fr.json";
import promptsDe from "../../../../../generated/method/prompt-packs.de.json";
import promptsPt from "../../../../../generated/method/prompt-packs.pt.json";
import exportsEn from "../../../../../generated/method/export-templates.en.json";
import exportsFi from "../../../../../generated/method/export-templates.fi.json";
import exportsFr from "../../../../../generated/method/export-templates.fr.json";
import exportsDe from "../../../../../generated/method/export-templates.de.json";
import exportsPt from "../../../../../generated/method/export-templates.pt.json";

interface Props { locale: Locale; cycle?: Cycle; station?: Station; role?: Role; entityId?: string }
const { locale, cycle, station, role, entityId } = Astro.props;
const manifests = { en: canvasEn, fi: canvasFi, fr: canvasFr, de: canvasDe, pt: canvasPt };
const promptData = { en: promptsEn, fi: promptsFi, fr: promptsFr, de: promptsDe, pt: promptsPt };
const exportData = { en: exportsEn, fi: exportsFi, fr: exportsFr, de: exportsDe, pt: exportsPt };
const canvases = manifests[locale].translations[locale];
const stationResources = station ? (station.resources ?? []).filter((resource) => !resource.draft) : [];
const stationCanvasIds = station ? [...new Set(station.steps.map((step) => step.canvasId).filter((id): id is string => Boolean(id)))] : [];
const roleCanvasIds = role ? role.canvases.map((canvas) => canvas.id) : [];
const canvasIds = stationCanvasIds.length ? stationCanvasIds : roleCanvasIds;
const prompts = role ? promptData[locale].translations[locale].filter((prompt) => prompt.routeId === role.id || role.promptIds.includes(prompt.id)) : [];
const templates = cycle ? exportData[locale].translations[locale].filter((template) => template.cycleId === cycle.id) : [];
const entity = station ?? role;
const toolEntityId = entityId ?? entity?.id;
---
{(station || role || cycle) && <section class="public-section island-stack" aria-label="Tools for this page">
  {station && <ResourceViewerIsland locale={locale} stationId={station.id} stationTitle={station.title} resources={stationResources} client:visible />}
  {entity && toolEntityId && canvasIds.map((canvasId) => {
    const canvas = canvases[canvasId as keyof typeof canvases];
    return canvas && <CanvasWorkspaceIsland locale={locale} entityId={toolEntityId} entityTitle={entity.title} canvas={canvas} client:visible />;
  })}
  {role && prompts.length > 0 && <PromptPackIsland locale={locale} routeId={role.id} prompts={prompts} client:visible />}
  {cycle && templates.length > 0 && <ConfluenceExportIsland locale={locale} entityId={cycle.id} templates={templates} client:visible />}
</section>}
