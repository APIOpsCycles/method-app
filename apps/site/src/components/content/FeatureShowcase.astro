---
import { features } from "../../content/features";
interface Props { heading?: string; intro?: string }
const { heading = "A method built to be used", intro = "Explore the capabilities that make APIOps Cycles navigable, interoperable, and practical for people and machines." } = Astro.props;
---
<section class="feature-showcase" id="features" aria-labelledby="feature-showcase-heading">
  <div class="feature-showcase__intro">
    <p class="public-kicker">Method features</p>
    <h2 id="feature-showcase-heading">{heading}</h2>
    <p>{intro}</p>
  </div>
  <div class="feature-showcase__grid">
    {features.map((feature) => (
      <a class="feature-card" href={`/features/${feature.slug}`}>
        <span class="feature-card__marker" aria-hidden="true">{feature.marker}</span>
        <h3>{feature.title}</h3>
        <p>{feature.summary}</p>
        <span class="feature-card__link">Explore feature <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </div>
</section>
