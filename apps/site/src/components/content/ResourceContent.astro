---
import { getCatalog, localePrefix, type Locale, type Resource } from "../../lib/method-data";
interface Props { resource: Resource; locale: Locale }
const { resource, locale } = Astro.props;
const prefix = localePrefix(locale);
const stations = getCatalog(locale).stations.filter((station) => (station.resources ?? []).some((item) => item.id === resource.id));
---
<main class="public-content">
  <nav class="public-breadcrumbs" aria-label="Breadcrumb"><a href={`${prefix}/`}>APIOps Cycles</a><span aria-hidden="true">/</span><span>{resource.title}</span></nav>
  <section class="public-hero"><p class="public-kicker">{resource.category}</p><h1>{resource.title}</h1><p>{resource.description}</p></section>
  <section class="public-section" aria-labelledby="outcomes"><h2 id="outcomes">Expected outcomes</h2><ul>{resource.outcomes.map((item) => <li>{item}</li>)}</ul></section>
  <section class="public-section" aria-labelledby="steps"><h2 id="steps">How to use it</h2><ol>{resource.steps.map((item) => <li>{item}</li>)}</ol></section>
  <section class="public-section" aria-labelledby="stations"><h2 id="stations">Related stations</h2><ul class="public-link-list">{stations.map((station) => <li><a href={`${prefix}/stations/${station.id}`}>{station.title}</a><span>{station.description}</span></li>)}</ul></section>
  <section class="public-section" aria-labelledby="license"><h2 id="license">Licensing</h2><p>This resource is part of the community method data. See the <a href="https://github.com/APIOpsCycles/apiops-cycles-method-data/blob/main/LICENSE">source license</a>.</p></section>
</main>
