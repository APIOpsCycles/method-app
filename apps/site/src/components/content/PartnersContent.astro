---
import partners from "../../../../../generated/method/partners.json";
import ParisCommunityNotice from "../ParisCommunityNotice.astro";
import { whitepapers, companion, resourceBundle, downloadSize } from "../../content/whitepapers";
const practitioners = partners.items.filter(partner => partner.title !== "You?");
const join = partners.items.find(partner => partner.title === "You?");
---
<main class="public-content partners-page">
  <section class="public-hero partners-hero">
    <div>
      <p class="public-kicker">Ideas, tools and people</p>
      <h1>Put APIOps Cycles<br />to work.</h1>
      <p>Bring one API or AI integration challenge. Explore the thinking, use the open resources, and find a practitioner to help you choose a useful next step.</p>
      <nav class="hero-actions" aria-label="Explore this page"><a class="partner-button" href="#partners">Find a partner ↗</a><a class="text-link" href="#whitepapers">Read the whitepapers ↓</a></nav>
    </div>
    <figure class="hero-illustration"><img src="/whitepapers/api-capability.svg" alt="APIOps Cycles figures connecting an API to a useful capability." width="520" height="310" /><figcaption>APIOps Cycles / Osaango Ltd · CC-BY-SA 4.0</figcaption></figure>
  </section>
  <ParisCommunityNotice />
  <section class="public-section" id="whitepapers" aria-labelledby="whitepaper-title">
    <div class="section-intro"><p class="public-kicker">Read, share, apply</p><h2 id="whitepaper-title">From recognising the problem<br />to improving the capability.</h2><p>Two complementary whitepapers by Marjukka Niinioja. Start with the experience, then explore the organisational work behind sustainable quality. Freely available, with no sign-up.</p></div>
    <div class="whitepaper-grid">
      {whitepapers.map((paper, index) => <article class:list={["whitepaper-card", `whitepaper-card--${paper.id}`]}>
        <div class="paper-copy"><p class="paper-kicker">Paper {index + 1} · {index === 0 ? 'Understand the dependency' : 'Sustain the capability'}</p><h3>{paper.title}</h3><p>{paper.description}</p><p class="paper-detail">{index === 0 ? 'A publishing journey, UI/DX/AX and five questions for your team.' : 'A supplier-payment example, lifecycle evidence and a repeatable team practice.'}</p><a class="partner-button" href={paper.url} download>Download Paper {index + 1} ↓</a><span class="download-meta">PDF · {paper.pages} pages · {paper.language} · {downloadSize(paper.bytes)}</span></div>
        <a class="paper-cover" href={paper.url} aria-label={`Read ${paper.title} (PDF)`}><img src={paper.cover} alt={`Cover of ${paper.title}`} width="509" height="720" loading="lazy" /></a>
      </article>)}
    </div>
    <article class="companion-card"><div><p class="paper-kicker">Optional practitioner resources</p><h3>Take the ideas into a team review.</h3><p>Full canvases, selected assessment mappings and a completed fictional improvement brief. The ZIP includes editable CanvasCreator JSON inputs, annotated SVGs and reference records.</p></div><div class="companion-downloads"><a class="text-link" href={companion.url} download>Companion PDF ↓<span class="download-meta">{companion.pages} pages · {downloadSize(companion.bytes)}</span></a><a class="text-link" href={resourceBundle.url} download>Editable resource pack ↓<span class="download-meta">ZIP · {downloadSize(resourceBundle.bytes)}</span></a></div></article>
    <p class="resource-license">Original content and APIOps artwork: CC-BY-SA 4.0. Keep creator credits on adapted canvases; referenced works retain their own terms. <a href="/licensing">About reuse</a>.</p>
  </section>
  <section class="public-section" id="partners" aria-labelledby="partners-title">
    <div class="section-intro"><p class="public-kicker">APIOps Cycles partners</p><h2 id="partners-title">Find people who can help<br />you apply the method.</h2><p>Work with practitioners on strategy, consumer experience, architecture, governance and ways of working. Explore each partner’s expertise and contact them directly about your situation.</p></div>
    <div class="practitioner-grid">{practitioners.map(partner => <article class="practitioner-card"><div class="partner-logo"><img src={partner.logo} alt={`${partner.title} logo`} width="190" height="64" loading="lazy" /></div><h3>{partner.title}</h3><p>{partner.description}</p><a class="text-link" href={partner.href}>Visit {partner.title} ↗</a></article>)}</div>
  </section>
  <section class="public-section conversation-section" aria-labelledby="conversation-title">
    <div class="section-intro"><p class="public-kicker">A useful first conversation</p><h2 id="conversation-title">You don’t need a perfect plan.<br />Bring a real challenge.</h2></div>
    <ol class="conversation-steps"><li><h3>Start with one task.</h3><p>Who needs to accomplish what, and where does the experience break down?</p></li><li><h3>Bring what you know.</h3><p>A consumer journey, an assessment finding or a recurring integration problem is a useful starting point.</p></li><li><h3>Explore the next decision.</h3><p>Discuss the people, evidence and work needed for a practical next step—not a full assessment in one conversation.</p></li></ol>
    <a class="partner-button" href="#partners">Choose a partner to talk with ↑</a>
    {join && <p class="join-partners">Help organisations apply APIOps Cycles? <a href={join.href}>Explore becoming a method partner ↗</a></p>}
  </section>
</main>
<style>
  .partners-page section[id] { scroll-margin-top: 6rem; }
  .partners-hero { max-width:none; display:grid; grid-template-columns:1.25fr .75fr; gap:2rem; align-items:center; margin-bottom:3rem; }
  .partners-hero h1 { font-size:clamp(2.8rem,5.7vw,4.8rem); }
  .partners-hero p:not(.public-kicker) { font-size:1.15rem; line-height:1.7; max-width:41rem; color:var(--muted); }
  .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.3rem; margin-top:1.6rem; }
  .hero-illustration { margin:0; padding:1.5rem 0; }
  .hero-illustration img { display:block; width:100%; height:auto; }
  .hero-illustration figcaption { margin-top:1rem; font-size:.65rem; color:var(--muted); }
  .partner-button { display:inline-flex; justify-content:center; align-items:center; gap:.8rem; background:#194fa6; color:white; text-decoration:none; font-weight:750; padding:.8rem 1.1rem; border-radius:.4rem; width:fit-content; }
  .partner-button:hover { background:#123b80; }
  a:focus-visible { outline:3px solid #8058cb; outline-offset:4px; }
  .text-link { font-weight:750; color:#194fa6; text-underline-offset:.22em; }
  .section-intro { max-width:49rem; margin-bottom:2rem; }
  .section-intro h2 { font-family:var(--font-heading,"Urbanist",sans-serif); font-size:clamp(1.9rem,3.5vw,2.8rem); line-height:1.1; letter-spacing:-.025em; margin:.6rem 0 1rem; }
  .section-intro > p:last-child { color:var(--muted); }
  .whitepaper-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.3rem; }
  .whitepaper-card { border:1px solid #d4dfef; background:#f0f5fd; border-top:4px solid #194fa6; border-radius:.7rem; padding:1.5rem; display:grid; grid-template-columns:minmax(0,1fr) 105px; gap:1rem; align-items:start; }
  .whitepaper-card--paper2 { background:#f5f1fc; border-color:#dfd4ef; border-top-color:#7854ad; }
  .paper-kicker { font-size:.7rem; font-weight:800; letter-spacing:.055em; text-transform:uppercase; color:#3b537a; margin:0 0 .75rem; }
  .paper-copy h3,.companion-card h3 { font-size:1.55rem; line-height:1.15; letter-spacing:-.02em; margin:0 0 1rem; }
  .paper-copy > p:not(.paper-kicker) { font-size:.92rem; }
  .paper-detail { color:#4a566a; }
  .paper-cover { display:block; background:white; border:1px solid #dae0e8; box-shadow:0 9px 20px #1c315218; transform:rotate(2deg); }
  .whitepaper-card--paper2 .paper-cover { transform:rotate(-2deg); }
  .paper-cover img { width:100%; height:auto; display:block; }
  .download-meta { display:block; font-size:.75rem; font-weight:450; color:#526079; margin-top:.55rem; }
  .paper-copy .partner-button { font-size:.85rem; margin-top:.5rem; }
  .companion-card { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:2rem; margin-top:1.4rem; padding:1.5rem; border:1px solid #dce2ea; border-radius:.7rem; }
  .companion-card p:last-child { margin-bottom:0; font-size:.92rem; }
  .companion-downloads { align-self:center; display:grid; gap:1.1rem; }
  .resource-license { font-size:.75rem; color:var(--muted); margin:1.2rem 0 3rem; }
  .practitioner-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; margin-bottom:3rem; }
  .practitioner-card { border:1px solid var(--panel-border,#d7dfed); border-radius:.7rem; padding:1.6rem; display:flex; flex-direction:column; align-items:flex-start; background:white; }
  .partner-logo { height:72px; display:flex; align-items:center; margin-bottom:1rem; }
  .partner-logo img { object-fit:contain; object-position:left center; max-width:190px; height:64px; }
  .practitioner-card h3 { font-size:1.35rem; margin:0; }
  .practitioner-card p { font-size:.92rem; color:var(--muted); flex:1; }
  .conversation-section { padding-bottom:1rem; }
  .conversation-steps { counter-reset:steps; list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,1fr); gap:1.6rem; margin:0 0 2rem; }
  .conversation-steps li { border-top:2px solid #7854ad; padding-top:1rem; }
  .conversation-steps li::before { counter-increment:steps; content:"0" counter(steps); font-size:.8rem; font-weight:800; color:#7854ad; }
  .conversation-steps h3 { font-size:1.05rem; margin:.6rem 0; }
  .conversation-steps p { font-size:.9rem; color:var(--muted); }
  .join-partners { margin-top:2rem; font-size:.9rem; }
  .join-partners a { color:#194fa6; font-weight:700; }
  @media(max-width:1050px) { .whitepaper-card { grid-template-columns:1fr; } .paper-cover { grid-row:1; width:110px; margin-bottom:.5rem; } }
  @media(max-width:700px) { .partners-hero,.whitepaper-grid,.practitioner-grid,.companion-card,.conversation-steps { grid-template-columns:1fr; } .partners-hero { gap:1rem; } .hero-illustration { max-width:320px; } .whitepaper-card { grid-template-columns:minmax(0,1fr) 100px; padding:1.2rem; } .paper-cover { grid-row:auto; width:auto; } .companion-card { gap:1rem; } }
  @media(max-width:390px) { .whitepaper-card { grid-template-columns:1fr; } .paper-cover { grid-row:1; width:100px; } }
</style>
