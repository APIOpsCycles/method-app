---
import { getCatalog, getLabels, localePrefix, type Locale } from "../../lib/method-data";
import { metroLineColor } from "../../lib/line-colors";
import MethodMap from "./MethodMap.astro";
import { PublicPillList } from "../islands/PublicSelectors";
import ContextualLinesSection from "../islands/ContextualLinesSection";
import MethodContext from "./MethodContext.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getCatalog(locale);
const prefix = localePrefix(locale);
const labels = getLabels(locale);
---
<main class="public-content">
  <MethodContext locale={locale} here="APIOps Cycles" />
  <section class="public-hero"><p class="public-kicker">{labels["home.kicker"]}</p><h1>{labels["home.title"]}</h1><p>{labels["home.description"]}</p></section>
  <section class="public-section island-stack" aria-label={labels["tools.interactive"]}>
    <MethodMap locale={locale} />
    <noscript><p class="no-script-note">Use the cycle, station, and stakeholder links above to open permanent method pages without JavaScript.</p></noscript>
  </section>
  <ContextualLinesSection client:idle title={labels["section.lines"]} prefix={prefix} cycles={data.cycles.map(({ id, slug }) => ({ id, slug }))} items={data.lines.map((line) => ({ id: line.id, slug: line.slug, title: line.title, description: line.description, color: metroLineColor(line.id), icon: line.icon }))} />
  <section class="public-section" aria-labelledby="roles"><h2 id="roles">{labels["section.stakeholderGuides"]}</h2><PublicPillList client:load label={labels["section.stakeholderGuides"]} items={data.routeProfiles.map((role) => ({ id: role.id, label: role.title, href: `${prefix}/roles/${role.id}` }))} /></section>
</main>
