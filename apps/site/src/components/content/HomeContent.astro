---
import { getCatalog, getLabels, localePrefix, type Locale } from "../../lib/method-data";
import MethodMap from "./MethodMap.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const data = getCatalog(locale);
const prefix = localePrefix(locale);
const labels = getLabels(locale);
---
<main class="public-content">
  <section class="public-hero"><p class="public-kicker">{labels["home.kicker"]}</p><h1>{labels["home.title"]}</h1><p>{labels["home.description"]}</p></section>
  <section class="public-section" aria-labelledby="cycles"><h2 id="cycles">{labels["section.cycles"]}</h2><div class="public-card-grid">{data.cycles.map((cycle) => <article class="public-card"><h3><a href={`${prefix}/cycles/${cycle.slug}`}>{cycle.title}</a></h3><p>{cycle.description}</p></article>)}</div></section>
  <section class="public-section" aria-labelledby="lines"><h2 id="lines">{labels["section.lines"]}</h2><div class="public-card-grid">{data.lines.map((line) => { const cycle = data.cycles.find((candidate) => line.stations.some((id) => candidate.stations.some((station) => station.id === id))); return cycle && <article class="public-card" style={`border-top: .35rem solid ${line.color}`}><h3><a href={`${prefix}/cycle/${cycle.slug}/lines/${line.slug}`}>{line.title}</a></h3><p>{line.description}</p></article>; })}</div></section>
  <section class="public-section" aria-labelledby="roles"><h2 id="roles">{labels["section.stakeholderGuides"]}</h2><ul class="public-link-list">{data.routeProfiles.map((role) => <li><a href={`${prefix}/roles/${role.id}`}>{role.title}</a><span>{role.summary}</span></li>)}</ul></section>
  <section class="public-section island-stack" aria-label={labels["tools.interactive"]}>
    <div class="tool-summary"><h2>{labels["section.methodMap"]}</h2><p>Compare the method’s cycles, stations, and stakeholder involvement before opening a focused entity page.</p></div>
    <MethodMap locale={locale} />
    <noscript><p class="no-script-note">Use the cycle, station, and stakeholder links above to open permanent method pages without JavaScript.</p></noscript>
  </section>
  <section class="public-section" aria-labelledby="license"><h2 id="license">{labels["section.attribution"]}</h2><p>APIOps Cycles method data is maintained by the APIOps Cycles community. See the <a href="https://github.com/APIOpsCycles/apiops-cycles-method-data/blob/main/LICENSE">source license</a> for reuse terms.</p>{locale === "en" && <p><a href="/design-system">Design system reference</a></p>}</section>
</main>
