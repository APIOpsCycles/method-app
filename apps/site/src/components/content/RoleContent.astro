---
import { getLabels, localePrefix, resourcePath, type Locale, type Role } from "../../lib/method-data";
import EntityTools from "./EntityTools.astro";
import { getCatalog } from "../../lib/method-data";
import MethodContext from "./MethodContext.astro";
import RoleParticipationTables from "../islands/RoleParticipationTables";
interface Props { role: Role; locale: Locale }
const { role, locale } = Astro.props;
const prefix = localePrefix(locale);
const labels = getLabels(locale);
const catalog = getCatalog(locale);
const involvementLabels = { lead: labels["involvement.lead"], core: labels["involvement.core"], consulted: labels["involvement.consulted"] } as const;
const participationCycles = catalog.cycles.flatMap((cycle) => {
  const rows = cycle.stations.flatMap((station) => {
    const stakeholder = station.stakeholders.find((item) => item.id === role.id);
    if (!stakeholder || !(stakeholder.involvement in involvementLabels)) return [];
    const resources = stakeholder.responsibilities.flatMap((responsibility) => {
      const resource = catalog.resources.find((item) => item.id === responsibility.resourceId && !item.draft);
      return resource ? [{ id: resource.id, title: resource.title, href: resourcePath(locale, resource) }] : [];
    });
    return [{
      station: { id: station.id, title: station.title, href: `${prefix}/cycles/${cycle.slug}/stations/${station.id}` },
      involvement: { value: stakeholder.involvement as keyof typeof involvementLabels, label: involvementLabels[stakeholder.involvement as keyof typeof involvementLabels] },
      resources: [...new Map(resources.map((resource) => [resource.id, resource])).values()],
    }];
  });
  return rows.length ? [{ id: cycle.id, title: cycle.title, href: `${prefix}/cycles/${cycle.slug}`, rows }] : [];
});
---
<main class="public-content">
  <nav class="public-breadcrumbs" aria-label={labels["chrome.breadcrumb"]}><a href={`${prefix}/`}>APIOps Cycles</a><span aria-hidden="true">/</span><span>{role.title}</span></nav>
  <MethodContext locale={locale} here={role.title} />
  <section class="public-hero"><p class="public-kicker">{labels["entity.role"]}</p><h1>{role.title}</h1><p>{role.summary}</p></section>
  <section class="public-section" aria-labelledby="cycles"><h2 id="cycles">{labels["section.relevantCycles"]}</h2><RoleParticipationTables client:idle roleId={role.id} cycles={participationCycles} labels={{ station: labels["entity.station"], involvement: labels["controls.stakeholderInvolvement"], resources: labels["section.recommendedResources"], noResources: labels["resources.emptyLinked"] }} /></section>
  <EntityTools locale={locale} role={role} />
</main>
