---
import { getLabels, localePrefix, type Locale, type Role } from "../../lib/method-data";
import EntityTools from "./EntityTools.astro";
interface Props { role: Role; locale: Locale }
const { role, locale } = Astro.props;
const prefix = localePrefix(locale);
const labels = getLabels(locale);
---
<main class="public-content">
  <nav class="public-breadcrumbs" aria-label={labels["chrome.breadcrumb"]}><a href={`${prefix}/`}>APIOps Cycles</a><span aria-hidden="true">/</span><span>{role.title}</span></nav>
  <section class="public-hero"><p class="public-kicker">{labels["entity.role"]}</p><h1>{role.title}</h1><p>{role.summary}</p></section>
  <section class="public-section" aria-labelledby="cycles"><h2 id="cycles">{labels["section.relevantCycles"]}</h2><ul class="public-link-list">{role.cycles.map((cycle) => <li><a href={`${prefix}/cycles/${cycle.id}`}>{cycle.title}</a><span>{cycle.description}</span></li>)}</ul></section>
  <section class="public-section" aria-labelledby="stations"><h2 id="stations">{labels["section.relevantStations"]}</h2><ul class="public-link-list">{role.stations.map((station) => <li><a href={`${prefix}/stations/${station.id}`}>{station.title}</a><span>{station.description}</span></li>)}</ul></section>
  <section class="public-section" aria-labelledby="decisions"><h2 id="decisions">{labels["section.decisionsOutputs"]}</h2><h3>{labels["section.decisions"]}</h3><ul>{role.decisions.map((item) => <li>{item}</li>)}</ul><h3>{labels["section.outputs"]}</h3><ul>{role.outputs.map((item) => <li>{item}</li>)}</ul></section>
  <section class="public-section" aria-labelledby="resources"><h2 id="resources">{labels["section.recommendedResources"]}</h2><ul class="public-link-list">{role.recommendedResources.filter((item) => !item.draft).map((resource) => <li><a href={`${prefix}/${resource.slug}`}>{resource.title}</a><span>{resource.description}</span></li>)}</ul></section>
  <EntityTools locale={locale} role={role} />
  <section class="public-section" aria-labelledby="license"><h2 id="license">{labels["section.licensing"]}</h2><p>This guide is community method content. Review the <a href="https://github.com/APIOpsCycles/apiops-cycles-method-data/blob/main/LICENSE">method data license</a> before reuse.</p></section>
</main>
