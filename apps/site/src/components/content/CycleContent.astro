---
import { localePrefix, uniqueById, type Cycle, type Locale } from "../../lib/method-data";
import EntityTools from "./EntityTools.astro";
import MethodMap from "./MethodMap.astro";
interface Props { cycle: Cycle; locale: Locale }
const { cycle, locale } = Astro.props;
const prefix = localePrefix(locale);
const resources = uniqueById(cycle.stations.flatMap((station) => station.resources ?? []).filter((item) => !item.draft));
const roles = uniqueById(cycle.audienceStakeholders.length ? cycle.audienceStakeholders : cycle.stations.flatMap((station) => station.stakeholders));
---
<main class="public-content">
  <nav class="public-breadcrumbs" aria-label="Breadcrumb"><a href={`${prefix}/`}>APIOps Cycles</a><span aria-hidden="true">/</span><span>{cycle.title}</span></nav>
  <section class="public-hero"><p class="public-kicker">Cycle</p><h1>{cycle.title}</h1><p>{cycle.description}</p>{cycle.purpose && <p>{cycle.purpose}</p>}</section>
  <section class="public-section" aria-label="Selected cycle map"><MethodMap locale={locale} cycleId={cycle.id} stationId={cycle.stations[0]?.id} /></section>
  <section class="public-section" aria-labelledby="stations"><h2 id="stations">Stations</h2><ol class="public-step-list">{cycle.stations.map((station) => <li><h3><a href={`${prefix}/stations/${station.id}`}>{station.title}</a></h3><p>{station.description}</p>{station.whyItMatters && <p>{station.whyItMatters}</p>}</li>)}</ol></section>
  <section class="public-section" aria-labelledby="criteria"><h2 id="criteria">Journey criteria</h2><div class="criteria-grid"><div><h3>Entry criteria</h3><ul>{cycle.entryCriteria.map((item) => <li>{item}</li>)}</ul></div><div><h3>Exit criteria</h3><ul>{cycle.exitCriteria.map((item) => <li>{item}</li>)}</ul></div></div></section>
  <section class="public-section" aria-labelledby="stakeholders"><h2 id="stakeholders">Stakeholders and roles</h2><ul class="public-link-list">{roles.map((role) => <li><a href={`${prefix}/roles/${role.id}`}>{role.title}</a><span>{role.description}</span></li>)}</ul></section>
  <section class="public-section" aria-labelledby="resources"><h2 id="resources">Resources and canvases</h2><ul class="public-link-list">{resources.map((resource) => <li><a href={`${prefix}/${resource.slug}`}>{resource.title}</a><span>{resource.description}</span></li>)}</ul></section>
  <EntityTools locale={locale} cycle={cycle} />
  <section class="public-section" aria-labelledby="license"><h2 id="license">Attribution and licensing</h2><p>APIOps Cycles method data is maintained by the APIOps Cycles community under its <a href="https://github.com/APIOpsCycles/apiops-cycles-method-data/blob/main/LICENSE">source license</a>.</p></section>
</main>
