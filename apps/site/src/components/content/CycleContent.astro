---
import { getLabels, localePrefix, uniqueById, type Cycle, type Locale } from "../../lib/method-data";
import EntityTools from "./EntityTools.astro";
import MethodMap from "./MethodMap.astro";
import { JourneyCriteria } from "@apiops/design-system/react";
import { PublicPillList, PublicResourceSelector } from "../islands/PublicSelectors";
interface Props { cycle: Cycle; locale: Locale }
const { cycle, locale } = Astro.props;
const prefix = localePrefix(locale);
const labels = getLabels(locale);
const resources = uniqueById(cycle.stations.flatMap((station) => station.resources ?? []).filter((item) => !item.draft));
const roles = uniqueById(cycle.audienceStakeholders.length ? cycle.audienceStakeholders : cycle.stations.flatMap((station) => station.stakeholders));
---
<main class="public-content">
  <nav class="public-breadcrumbs" aria-label={labels["chrome.breadcrumb"]}><a href={`${prefix}/`}>APIOps Cycles</a><span aria-hidden="true">/</span><span>{cycle.title}</span></nav>
  <section class="public-hero"><p class="public-kicker">{labels["entity.cycle"]}</p><h1>{cycle.title}</h1><p>{cycle.description}</p>{cycle.purpose && <p>{cycle.purpose}</p>}</section>
  <section class="public-section" aria-label={labels["map.selectedCycle"]}><MethodMap locale={locale} cycleId={cycle.id} stationId={cycle.stations[0]?.id} /></section>
  <section class="public-section" aria-labelledby="roles"><h2 id="roles">{labels["section.people"]}</h2><PublicPillList client:load label={labels["section.people"]} items={roles.map((role) => ({ id: role.id, label: role.title, href: `${prefix}/roles/${role.id}` }))} /></section>
  <section class="public-section" aria-labelledby="resources"><h2 id="resources">{labels["section.resourcesCanvases"]}</h2><PublicResourceSelector client:load emptyLabel={labels["resources.emptyLinked"]} items={resources.map((resource) => ({ id: resource.id, type: resource.category, title: resource.title, description: resource.description, href: `${prefix}/${resource.slug}` }))} /></section>
  <section class="public-section" aria-labelledby="criteria"><h2 id="criteria">{labels["section.journeyCriteria"]}</h2><JourneyCriteria entryLabel={labels["section.entryCriteria"]} exitLabel={labels["section.exitCriteria"]} entryCriteria={cycle.entryCriteriaDetails} exitCriteria={cycle.exitCriteriaDetails} /></section>
  <section class="public-section" aria-labelledby="stations"><h2 id="stations">{labels["section.stations"]}</h2><ol class="public-step-list">{cycle.stations.map((station) => <li><h3><a href={`${prefix}/cycles/${cycle.slug}/stations/${station.id}`}>{station.title}</a></h3><p>{station.description}</p>{station.whyItMatters && <p>{station.whyItMatters}</p>}</li>)}</ol></section>
    <EntityTools locale={locale} cycle={cycle} />
</main>
