---
import MethodContextStrip from "../islands/MethodContextStrip";
import { getCatalog, getLabels, type Locale } from "../../lib/method-data";
import { getGoals, type PageMethodContext } from "../../lib/method-graph";
import { metroLineColor } from "../../lib/line-colors";
interface Props { locale: Locale; pageContext?: PageMethodContext; here: string }
const { locale, pageContext, here } = Astro.props;
const labels = getLabels(locale);
const catalog = getCatalog(locale);
const prefix = locale === "en" ? "" : `/${locale}`;
---
<MethodContextStrip client:idle stakeholders={catalog.routeProfiles.map((role) => ({ id: role.id, label: role.title }))} goals={getGoals(locale)} cycles={catalog.cycles.map((item) => ({ id: item.id, slug: item.slug, label: item.title, stations: item.stations.map((station) => ({ id: station.id, label: station.title })) }))} lines={catalog.lines.map((item) => ({ id: item.id, slug: item.slug, label: item.title, stationIds: item.stations, color: metroLineColor(item.id) }))} pageContext={pageContext} prefix={prefix} here={here} labels={{ context: labels["context.label"], who: labels["context.who"], why: labels["context.why"], where: labels["context.where"], cycle: labels["context.cycle"], notSelected: labels["context.notSelected"], reset: labels["controls.resetContext"], change: labels["context.change"], close: labels["context.close"], done: labels["context.done"], findPath: labels["context.findPath"], setupHelp: labels["context.setupHelp"], choosePerspective: labels["context.choosePerspective"], dismiss: labels["context.dismiss"], selectStakeholder: labels["controls.selectStakeholder"], selectGoal: labels["controls.selectGoal"], lead: labels["involvement.lead"], core: labels["involvement.core"], consulted: labels["involvement.consulted"], involvementLead: labels["context.involvementLead"], involvementCore: labels["context.involvementCore"], involvementConsulted: labels["context.involvementConsulted"], involvementUnmapped: labels["context.involvementUnmapped"], onPath: labels["context.onPath"], next: labels["context.next"], offPath: labels["context.offPath"], recommended: labels["context.recommended"] }} />
