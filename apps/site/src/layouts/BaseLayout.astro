---
import "@apiops/design-system/styles.css";
import { designSystemAssets } from "@apiops/design-system/assets";
import "../styles/global.css";
import { canonicalUrl } from "../env";
import type { Locale } from "../lib/method-data";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Advertisement from "../components/Advertisement.astro";
import SiteAnnouncement from "../components/islands/SiteAnnouncement";
import { selectAd } from "../../../../data/ads";
import announcement from "../../../../data/announcement.json";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  languageAlternates?: { lang: Locale | string; path: string }[];
  xDefaultPath?: string;
  openGraphType?: string;
  twitterCard?: "summary" | "summary_large_image" | "app" | "player";
  twitterSite?: string;
  twitterCreator?: string;
  socialImage?: string;
  twitterImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robots?: string;
}

const {
  title = "APIOps Cycles Knowledge Catalog",
  description = "A static, localizable APIOps Cycles method site with method-catalog routes, canvas workspaces, Confluence exports, and method data surfaces.",
  lang = "en",
  canonicalPath = Astro.url.pathname,
  languageAlternates = [],
  xDefaultPath,
  openGraphType = "website",
  twitterCard = "summary_large_image",
  twitterSite,
  twitterCreator,
  socialImage = "/apiops-cycles-2026-card.jpg",
  twitterImage = socialImage,
  jsonLd,
  robots,
} = Astro.props;
const pageTitle = title === "APIOps Cycles Knowledge Catalog" ? title : `${title} | APIOps Cycles`;
const canonical = canonicalUrl(canonicalPath);
const keywords = [
  "APIOps Cycles",
  "API productization",
  "integration productization",
  "knowledge catalog",
  "Confluence templates",
  "canvas workspace",
  "API design",
  "capability productization",
];
const locale = lang as Locale;
const ad = selectAd(undefined, Astro.url.pathname);
const announcementLabels = announcement.translations[locale] ?? announcement.translations[announcement.defaultLocale];
const announcementHref = locale === announcement.defaultLocale
  ? announcement.href
  : `/${locale}${announcement.href}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <link rel="canonical" href={canonical} />
    {languageAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={canonicalUrl(alternate.path)} />)}
    {(xDefaultPath || languageAlternates.length > 0) && <link rel="alternate" hreflang="x-default" href={canonicalUrl(xDefaultPath ?? languageAlternates.find((alternate) => alternate.lang === "en")?.path ?? canonicalPath)} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href={designSystemAssets.favicon} type="image/svg+xml" />
    <link rel="shortcut icon" href={designSystemAssets.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={canonicalUrl(socialImage)} />
    <meta property="og:image:alt" content="APIOps Cycles method overview" />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    {twitterImage && <meta name="twitter:image" content={canonicalUrl(twitterImage)} />}
    {twitterImage && <meta name="twitter:image:alt" content="APIOps Cycles method overview" />}
  </head>
  <body>
    <div class="global-site-shell">
      <SiteHeader locale={locale} />
      <div class:list={["page-with-ad", { "page-with-ad--active": ad }]}>
        <slot />
        {ad && <Advertisement ad={ad} />}
      </div>
      <SiteFooter locale={locale} />
      <SiteAnnouncement
        id={announcement.id}
        href={announcementHref}
        message={announcementLabels.message}
        linkLabel={announcementLabels.linkLabel}
        dismissLabel={announcementLabels.dismissLabel}
        client:load
      />
    </div>
  </body>
</html>
