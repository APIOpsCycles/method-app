{
  "name": "apiops-cycles-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "predev": "npm run prepare:local-data",
    "dev": "npm run dev --workspace @apiops/site",
    "prebuild": "npm run prepare:local-data",
    "build": "npm run build --workspace @apiops/site",
    "start": "npm run preview --workspace @apiops/site",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:design-system-boundaries": "node scripts/check-design-system-boundaries.mjs",
    "pretest:astro-integration": "npm run prepare:local-data",
    "test:astro-integration": "node --test apps/site/test/*.test.mjs",
    "prepare:local-data": "node packages/apiops-design-system/scripts/build.mjs && npm run sync:design-system-assets && npm run sync:method-data",
    "sync:method-data": "node scripts/sync-method-data.mjs",
    "db:generate": "drizzle-kit generate",
    "sync:design-system-assets": "node scripts/sync-design-system-assets.mjs",
    "preview": "npm run preview --workspace @apiops/site"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@iconify-json/material-symbols-light": "^1.2.85",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "apiops-cycles-method-data": "^4.0.0",
    "canvascreator": "^1.8.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10",
    "ws": "8.21.0",
    "esbuild": "0.25.12"
  },
  "type": "module"
}
