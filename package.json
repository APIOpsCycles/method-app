{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "predev": "npm run prepare:local-data",
    "dev": "vinext dev",
    "prebuild": "npm run prepare:local-data",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "prepare:local-data": "node packages/apiops-design-system/scripts/build.mjs && npm run sync:design-system-assets && npm run sync:method-data",
    "sync:method-data": "node scripts/sync-method-data.mjs",
    "db:generate": "drizzle-kit generate",
    "sync:design-system-assets": "node scripts/sync-design-system-assets.mjs"
  },
  "dependencies": {
    "@apiops/design-system": "0.1.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.43.0",
    "@iconify-json/material-symbols-light": "^1.2.85",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "apiops-cycles-method-data": "^4.0.0",
    "canvascreator": "^1.8.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "unplugin-icons": "^23.0.1",
    "vinext": "0.0.50",
    "vite": "8.1.3",
    "wrangler": "4.107.0"
  },
  "overrides": {
    "postcss": "8.5.10",
    "ws": "8.21.0",
    "esbuild": "0.25.12"
  },
  "type": "module"
}
